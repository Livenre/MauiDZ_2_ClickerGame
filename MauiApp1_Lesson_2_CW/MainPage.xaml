<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MauiApp1_Lesson_2_CW.MainPage">

    <!-- Grid ділить екран на 2 однакові колонки (*, *) -->
    <Grid 
        ColumnDefinitions="*, *" 
        RowDefinitions="*" 
        Padding="30" 
        ColumnSpacing="30">

        <!-- ============================================== -->
        <!-- ЛІВА КОЛОНКА (Клікер і статистика)             -->
        <!-- ============================================== -->
        <VerticalStackLayout 
            Grid.Column="0" 
            Spacing="20" 
            VerticalOptions="Center">
            
            <Label 
                Text="КЛІКЕР" 
                FontSize="32" 
                FontAttributes="Bold" 
                TextColor="White" 
                HorizontalOptions="Center" />
            
            <!-- Рахунок з іконкою монети -->
            <HorizontalStackLayout 
                HorizontalOptions="Center" 
                Spacing="10">
                <Image 
                    Source="current_coin.png" 
                    WidthRequest="35" 
                    HeightRequest="35" 
                    VerticalOptions="Center"/>
                <Label 
                    x:Name="CoinsLabel" 
                    Text="0" FontSize="32" 
                    TextColor="#FFD700" 
                    FontAttributes="Bold" 
                    VerticalOptions="Center" />
            </HorizontalStackLayout>

            <!-- КАСТОМНА КНОПКА З ДВОМА КАРТИНКАМИ -->
            <Border 
                StrokeShape="RoundRectangle 75" 
                BackgroundColor="#4CAF50" 
                HeightRequest="150" 
                Margin="20,0" 
                StrokeThickness="0">
                <!-- Робимо так, щоб Border реагував на клік як звичайна кнопка -->
                <Border.GestureRecognizers>
                    <TapGestureRecognizer 
                        Tapped="OnClickButtonClicked" />
                </Border.GestureRecognizers>
                
                <!-- Сітка всередині кнопки: Ліва картинка | Текст | Права картинка -->
                <Grid 
                    ColumnDefinitions="Auto, *, Auto" 
                    Padding="30, 0">
                    <Image 
                        Grid.Column="0" 
                        Source="left_side_click.png" 
                        WidthRequest="70" 
                        HeightRequest="70" 
                        VerticalOptions="Center" />
                    <Label 
                        Grid.Column="1" 
                        Text="КЛІК!" 
                        FontSize="30" 
                        TextColor="White" 
                        FontAttributes="Bold" 
                        HorizontalOptions="Center" 
                        VerticalOptions="Center" />
                    <Image 
                        Grid.Column="2" 
                        Source="right_side_click.png" 
                        WidthRequest="70" 
                        HeightRequest="70" 
                        VerticalOptions="Center" />
                </Grid>
            </Border>

            <!-- Статистика з іконками -->
            <HorizontalStackLayout 
                HorizontalOptions="Center" 
                Spacing="10" 
                Margin="0,10,0,0">
                <Image 
                    Source="upgrade_click.png" 
                    WidthRequest="25" 
                    HeightRequest="25" 
                    VerticalOptions="Center"/>
                <Label 
                    x:Name="ClickPowerLabel" 
                    Text="За клік: 1" 
                    FontSize="20" 
                    TextColor="White" 
                    VerticalOptions="Center" />
            </HorizontalStackLayout>
            
            <HorizontalStackLayout 
                HorizontalOptions="Center" 
                Spacing="10" 
                x:Name="CritContainer" 
                IsVisible="False">
                <Image 
                    Source="crit_rate.png" 
                    WidthRequest="25" 
                    HeightRequest="25" 
                    VerticalOptions="Center"/>
                <Label 
                    x:Name="CritLabel" 
                    Text="Шанс криту: 0% (x5)" 
                    FontSize="20" 
                    TextColor="Orange" 
                    VerticalOptions="Center" />
            </HorizontalStackLayout>
            
            <HorizontalStackLayout 
                HorizontalOptions="Center" Spacing="10">
                <Image 
                    Source="buy_auto_clicker.png" 
                    WidthRequest="25" 
                    HeightRequest="25" 
                    VerticalOptions="Center"/>
                <Label 
                    x:Name="AutoClickerLabel" 
                    Text="Автоклікери: 0" 
                    FontSize="20"
                    TextColor="White" 
                    VerticalOptions="Center" />
            </HorizontalStackLayout>
            
            <HorizontalStackLayout 
                HorizontalOptions="Center" 
                Spacing="10" 
                x:Name="DelayContainer" 
                IsVisible="False">
                <Image 
                    Source="speed_up_auto_clicker.png" 
                    WidthRequest="25" 
                    HeightRequest="25" 
                    VerticalOptions="Center"/>
                <Label 
                    x:Name="DelayLabel" 
                    Text="Швидкість автоклікера: 1.0 кліків/сек" 
                    FontSize="20" TextColor="LightSkyBlue" 
                    VerticalOptions="Center" />
            </HorizontalStackLayout>
        
        </VerticalStackLayout>


        <!-- ============================================== -->
        <!-- ПРАВА КОЛОНКА (Магазин)                        -->
        <!-- ============================================== -->
        <VerticalStackLayout 
            Grid.Column="1" 
            Spacing="20" 
            VerticalOptions="Center">
            
            <!-- Заголовок магазину з іконкою візка -->
            <HorizontalStackLayout 
                HorizontalOptions="Center" 
                Spacing="15" 
                Margin="0,0,0,10">
                <Image 
                    Source="shop.png" 
                    WidthRequest="40" 
                    HeightRequest="40" 
                    VerticalOptions="Center" />
                <Label 
                    Text="МАГАЗИН" 
                    FontSize="26" 
                    FontAttributes="Bold" 
                    TextColor="White" 
                    VerticalOptions="Center" />
            </HorizontalStackLayout>

            <Button 
                x:Name="UpgradeButton" 
                Text="Покращити клік — 10 монет" 
                FontSize="18" HeightRequest="70" 
                ImageSource="upgrade_click.png" 
                ContentLayout="Left, 15" 
                Clicked="OnUpgradeClicked" />
            
            <Button 
                x:Name="AutoClickerButton" 
                Text="Купити автоклікер — 50 монет" 
                FontSize="18" 
                HeightRequest="70" 
                ImageSource="buy_auto_clicker.png" 
                ContentLayout="Left, 15" 
                Clicked="OnBuyAutoClickerClicked" />
            
            <Button 
                x:Name="CritButton" 
                Text="Шанс криту +0.5% — 100 монет" 
                FontSize="18" 
                HeightRequest="70" 
                BackgroundColor="#FF9800" 
                ImageSource="crit_rate.png" 
                ContentLayout="Left, 15" 
                Clicked="OnUpgradeCritClicked" />
            
            <Button 
                x:Name="SpeedButton" 
                Text="Прискорити автоклікер - 150 монет" 
                FontSize="18" 
                HeightRequest="70" 
                BackgroundColor="#03A9F4" 
                ImageSource="speed_up_auto_clicker.png" 
                ContentLayout="Left, 15" 
                Clicked="OnUpgradeSpeedClicked" 
                IsVisible="False" />
        
        </VerticalStackLayout>

    </Grid>

</ContentPage>